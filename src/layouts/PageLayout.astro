---
import Layout from './Layout.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import SiteNav from '../components/SiteNav.astro';
import ArticleHero from '../components/ArticleHero.astro';
interface Props {
    title: string;
    cover?: string | null;
    description?: string;
    subclass?: string;
}
const { title, cover, description, subclass } = Astro.props;
---
<Layout title={title} description={description} image={cover} current="page">
    <header class="site-header outer"><div class="inner"><SiteNav current="page" /></div></header>
    <main id="site-main">
        <article class={`leota-article ${subclass || ''}`}>
            <ArticleHero title={title} cover={cover} description={description} />
            <section class="leota-content leota-canvas"><slot /></section>
        </article>
    </main>
    <ImageLightbox />
</Layout>
