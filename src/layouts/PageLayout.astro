---
import Layout from './Layout.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import type { CampaignId } from '../config';
import SiteNav from '../components/SiteNav.astro';
import ArticleHero from '../components/ArticleHero.astro';
interface Props {
    title: string;
    cover?: string | null;
    description?: string;
    subclass?: string;
    campaign?: CampaignId;
    /** Ask search engines not to index the page (not access control). */
    noindex?: boolean;
    /** Link-preview (Open Graph) image when there is no hero cover, or it should differ. */
    image?: string | null;
}
const { title, cover, description, subclass, campaign, noindex, image } = Astro.props;
---
<Layout title={title} description={description} image={image ?? cover} current="page" campaign={campaign} noindex={noindex}>
    <header class="site-header outer"><div class="inner"><SiteNav current="page" /></div></header>
    <main id="site-main">
        <article class={`leota-article ${subclass || ''}`}>
            <ArticleHero title={title} cover={cover} description={description} />
            <section class="leota-content leota-canvas"><slot /></section>
        </article>
    </main>
    <ImageLightbox />
</Layout>
