---
import BaseHead from '../components/BaseHead.astro';
import SubscribeModal from '../components/SubscribeModal.astro';
import Navigation from '../components/Navigation.astro';
import { SITE_CONFIG, getAssetUrl } from '../config';
import { ClientRouter } from 'astro:transitions';

// Import CSS stylesheets so Astro bundles them
import '../styles/global.css';
import '../styles/screen.css';
import '../styles/leota.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  articleDate?: string | Date;
  tags?: string[];
  author?: string;
  current?: string;
}

const {
  title,
  description,
  image,
  type = 'website',
  articleDate,
  tags = [],
  author,
  current,
} = Astro.props;

const currentYear = new Date().getFullYear();
const bodyClass = current === 'home' ? 'home-template' : `${current || 'page'}-template`;
---

<!DOCTYPE html>
<html lang="en" class={`${SITE_CONFIG.theme}-mode`} style={`--ghost-accent-color: ${SITE_CONFIG.accentColor}; --color-on-accent: ${SITE_CONFIG.accentTextColor};`}>
<head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      articleDate={articleDate}
      tags={tags}
      author={author}
    />
    <ClientRouter />
</head>
<body class={`leota ${bodyClass}`}>
    <a class="skip-link" href="#site-main">Skip to content</a>
    <div class="site-wrapper">
        <!-- Main Content Slot -->
        <slot />

        <!-- Footer -->
        <footer class="site-footer outer">
            <div class="site-footer-content inner">
                <section class="copyright">
                    <a href={getAssetUrl('/')}>{SITE_CONFIG.title}</a> &copy; {currentYear}
                </section>
                <nav class="site-footer-nav" aria-label="Footer">
                    <Navigation secondary />
                </nav>
            </div>
        </footer>
    </div>

    <!-- Subscribe Modal overlay -->
    {SITE_CONFIG.subscribers && <SubscribeModal />}
</body>
</html>
