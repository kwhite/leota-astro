---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import Layout from './Layout.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import SiteNav from '../components/SiteNav.astro';
import ArticleHero from '../components/ArticleHero.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_CONFIG } from '../config';

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { title, cover, tags = [], author, date, description, subclass, disqus } = post.data;
const authorEntry = await getEntry(author);
const recentPosts = (await getCollection('posts'))
    .filter(p => p.id !== post.id)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 3);
const isDisqusEnabled = disqus !== false && SITE_CONFIG.disqus;
---

<Layout title={title} description={description} image={cover} type="article"
    articleDate={date} tags={tags} author={authorEntry?.data.name} current="post">
    <header class="site-header outer"><div class="inner"><SiteNav current="post" /></div></header>
    <main id="site-main">
        <article class={`leota-article ${subclass || ''}`}>
            <ArticleHero title={title} cover={cover} description={description} primaryTag={tags[0]} />
            <!-- The publication hid its byline. Author/date remain in document metadata. -->
            <section class="leota-content leota-canvas"><slot /></section>
                {isDisqusEnabled && (
                    <section class="post-full-comments">
                        <div id="disqus_thread"></div>
                        <script is:inline define:vars={{
                          shortname: SITE_CONFIG.disqusShortname,
                          url: Astro.url.href,
                          id: post.id,
                          title: title
                        }}>
                            var disqus_config = function () {
                                this.page.url = url;
                                this.page.identifier = id;
                                this.page.title = title;
                            };
                            var loadDisqus = function() {
                                if (window.DISQUS) {
                                    window.DISQUS.reset({
                                        reload: true,
                                        config: disqus_config
                                    });
                                } else {
                                    var d = document, s = d.createElement('script');
                                    s.src = 'https://' + shortname + '.disqus.com/embed.js';
                                    s.setAttribute('data-timestamp', +new Date());
                                    (d.head || d.body).appendChild(s);
                                }
                            };
                            if ('IntersectionObserver' in window) {
                                var observer = new IntersectionObserver(function(entries, observer) {
                                    entries.forEach(function(entry) {
                                        if (entry.isIntersecting) {
                                            loadDisqus();
                                            observer.unobserve(entry.target);
                                        }
                                    });
                                }, { rootMargin: '0px 0px 300px 0px' });
                                var target = document.getElementById('disqus_thread');
                                if (target) {
                                    observer.observe(target);
                                }
                            } else {
                                loadDisqus();
                            }
                        </script>
                    </section>
                )}
        </article>
    </main>
    {recentPosts.length > 0 && <aside class="leota-recent outer" aria-label="Recent posts">
        <div class="inner leota-recent-grid">{recentPosts.map(post => <PostCard post={post} />)}</div>
    </aside>}
    <ImageLightbox />
</Layout>
