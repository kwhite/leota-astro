---
import type { CollectionEntry } from 'astro:content';
import { getAssetUrl, getExcerpt, getReadingTime } from '../config';
interface Props {
    post: CollectionEntry<'posts'>;
    indexClass?: string;
}
const { post, indexClass = '' } = Astro.props;
const { title, cover, tags, description, date } = post.data;
const postLink = getAssetUrl(`/${post.id}/`);
const readingTime = getReadingTime(post.body || '');
const excerpt = description || getExcerpt(post.body || '');
const published = new Date(date);
const formattedDate = published.toLocaleDateString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Chicago',
});
---
<article class={`post-card ${indexClass} ${!cover ? 'no-image' : ''}`}>
    {cover && <a class="post-card-image-link" href={postLink} aria-label={title} tabindex="-1">
        <img class="post-card-image" src={getAssetUrl(cover)} alt="" loading="lazy" />
    </a>}
    <div class="post-card-content">
        <a class="post-card-content-link" href={postLink}>
            <header class="post-card-header">
                {tags[0] && <span class="post-card-tags">{tags[0]}</span>}
                <h2 class="post-card-title">{title}</h2>
            </header>
            {excerpt && <div class="post-card-excerpt"><p>{excerpt}</p></div>}
        </a>
        <footer class="post-card-meta">
            <time datetime={published.toISOString()}>{formattedDate}</time>
            <span class="post-card-meta-length">{readingTime}</span>
        </footer>
    </div>
</article>
