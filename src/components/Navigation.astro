---
import { PRIMARY_NAVIGATION, SECONDARY_NAVIGATION, getAssetUrl } from '../config';
interface Props { secondary?: boolean; }
const items = Astro.props.secondary ? SECONDARY_NAVIGATION : PRIMARY_NAVIGATION;
---
<ul class="publication-links">
    {items.map(item => <li>
        {item.available ? (
            <a href={getAssetUrl(item.href)} aria-current={Astro.url.pathname === getAssetUrl(item.href) ? 'page' : undefined}>{item.label}</a>
        ) : <span aria-disabled="true">{item.label}</span>}
    </li>)}
</ul>
