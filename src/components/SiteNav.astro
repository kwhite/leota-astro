---
import Navigation from './Navigation.astro';
import { SITE_CONFIG, getAssetUrl } from '../config';
interface Props { current?: string; }
const { current } = Astro.props;
---
<nav class:list={['publication-nav', { 'publication-nav-home': current === 'home' }]} aria-label="Main">
    <a class="publication-logo" href={getAssetUrl('/')} aria-label={`${SITE_CONFIG.title} home`}>
        <img src={getAssetUrl(SITE_CONFIG.logo)} alt="" width="40" height="40" />
    </a>
    <div class="publication-desktop-nav"><Navigation /></div>
    <details class="publication-mobile-nav">
        <summary aria-label="Main menu"><span></span><span></span></summary>
        <Navigation />
    </details>
</nav>
<script>
    // Native details remains usable without JavaScript; Escape restores focus.
    document.addEventListener('astro:page-load', () => {
        const menu = document.querySelector<HTMLDetailsElement>('.publication-mobile-nav');
        menu?.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
                menu.open = false;
                menu.querySelector('summary')?.focus();
            }
        });
    });
</script>
