              <option>G</option><option>PG</option><option>PG-13</option><option selected>R</option><option>NC-17</option><option>Other</option>
            </select>
            <input aria-label="Movie Rating (Other)" name="Movie Rating (Other)" type="text" placeholder="If ‘Other’, specify" disabled />
          </div>
        </div>
      </div>

      <div class="rc-legend">
