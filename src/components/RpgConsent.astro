<script>
  function initConsent() {
    document.querySelectorAll<HTMLFormElement>('.rpg-consent form').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';
      const container = form.querySelector<HTMLElement>('#customTopics')!;
      let index = 0;
      function addRow(focus = false) {
        const row = document.createElement('div');
        row.className = 'rc-custom-row';
        const label = document.createElement('label');
        label.textContent = 'Topic';
        const topic = document.createElement('input');
        topic.type = 'text';
        topic.name = `Custom Topics[${index}][Topic]`;
        topic.placeholder = 'e.g., Clowns';
        label.append(topic);
        row.append(label);
        const radios = ['Green', 'Yellow', 'Red'].map((value) => {
          const pill = document.createElement('label');
          pill.className = `pill ${value[0].toLowerCase()}`;
          pill.title = value;
          const radio = document.createElement('input');
          radio.type = 'radio';
          radio.className = 'sr-only';
          radio.name = `Custom Topics[${index}][Consent]`;
          radio.value = value;
          radio.setAttribute('aria-label', `Custom topic ${index + 1} — ${value}`);
          pill.append(radio, value[0]);
          row.append(pill);
          return radio;
        });
        const sync = () => {
          const hasRating = radios.some((radio) => radio.checked);
          topic.required = hasRating;
          radios.forEach((radio) => { radio.required = !!topic.value.trim(); });
        };
        topic.addEventListener('input', sync);
        radios.forEach((radio) => radio.addEventListener('change', sync));
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'btn secondary';
        remove.textContent = 'Remove';
        remove.setAttribute('aria-label', 'Remove this topic');
        remove.addEventListener('click', () => {
          row.remove();
          form.querySelector<HTMLButtonElement>('#addTopicBtn')!.focus();
        });
        row.append(remove);
        container.append(row);
        index++;
        if (focus) topic.focus();
      }
      form.querySelector('#addTopicBtn')!.addEventListener('click', () => addRow(true));
      form.querySelector('#clearTopicsBtn')!.addEventListener('click', () => container.replaceChildren());
      form.addEventListener('reset', () => { container.replaceChildren(); index = 0; addRow(); });
      addRow();
    });
  }
  initConsent();
  document.addEventListener('astro:page-load', initConsent);
</script>

