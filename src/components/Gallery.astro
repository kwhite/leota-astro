---
import { getAssetUrl } from '../config';
import { galleryRows } from '../utils/gallery';
interface GalleryImage {
    image: string;
    alt: string;
    width: number;
    height: number;
    fullSize?: string;
}
interface Props {
    images?: GalleryImage[];
    rows?: GalleryImage[][];
    size?: 'regular' | 'wide' | 'full';
    caption?: string;
}
const { images, rows: explicitRows, size = 'wide', caption } = Astro.props;
// Explicit rows override automatic grouping for deliberately composed galleries.
if (explicitRows === undefined && (!Array.isArray(images) || images.length === 0)) {
    throw new Error('Gallery needs a non-empty images list or explicit rows.');
}
const rows = explicitRows ?? galleryRows(images!);
if (!Array.isArray(rows) || rows.length === 0) throw new Error('Gallery rows must be a non-empty list of rows.');
// Plain captions use the prop; formatted captions use the component body.
const hasCaption = !!caption || Astro.slots.has('default');
rows.forEach((row, index) => {
    if (!Array.isArray(row) || row.length === 0) throw new Error(`Gallery row ${index + 1} must be a non-empty list of images; wrap a single row as rows={[[ ... ]]}.`);
    row.forEach(({ image, width, height }) => {
        if (!(width > 0 && height > 0)) throw new Error(`Gallery image ${image} needs positive numeric width and height.`);
    });
});
// Proportional flex values give every image in a row the same height.
const flex = ({ width, height }: GalleryImage) => +(width / height).toFixed(4);
---
<figure class:list={['kg-card', 'kg-gallery-card', { [`kg-width-${size}`]: size !== 'regular', 'kg-card-hascaption': hasCaption }]}><div class="kg-gallery-container">{rows.map(row => (
    <div class="kg-gallery-row">{row.map(item => (
        <div class="kg-gallery-image" style={`flex: ${flex(item)}`}><a href={getAssetUrl(item.fullSize ?? item.image)} aria-label={item.alt ? `Open ${item.alt} in full size` : 'Open image in full size'}><img src={getAssetUrl(item.image)} width={item.width} height={item.height} alt={item.alt} loading="lazy" /></a></div>
    ))}</div>
))}</div>{hasCaption && <figcaption>{caption}<slot /></figcaption>}</figure>
