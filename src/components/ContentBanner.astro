---
import { getAssetUrl } from '../config';
interface Props {
    title: string;
    image: string;
    id?: string;
    description?: string | null;
    href?: string | null;
    label?: string | null;
    width?: 'regular' | 'wide' | 'full';
    align?: 'left' | 'center';
}
const { title, image, id, description, href, label, width = 'regular', align = 'center' } = Astro.props;
---
<section class:list={['content-banner', `kg-width-${width}`, `content-banner-${align}`]} aria-labelledby={id}>
    <img class="content-banner-image" src={getAssetUrl(image)} alt="" loading="lazy" />
    <div class="content-banner-text">
        <h2 id={id}>{title}</h2>
        {description && <p>{description}</p>}
        {href && label && <a class="content-banner-button" href={getAssetUrl(href)}>{label}</a>}
    </div>
</section>
<style>
    .content-banner { position: relative; isolation: isolate; display: grid; align-items: center; min-height: clamp(260px, 40vw, 440px); overflow: hidden; background: #000; color: #fff; }
    .content-banner::after { content: ''; position: absolute; inset: 0; z-index: -1; background: #0007; }
    .content-banner-image { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100% !important; object-fit: cover; }
    .content-banner-text { padding: clamp(28px, 6vw, 72px); }
    .content-banner-center { text-align: center; }
    .content-banner h2 { margin: 0; color: #fff; font-size: clamp(3rem, 4vw, 4.8rem); line-height: 1.15; }
    .content-banner p { max-width: 700px; margin: 24px auto 0; font-size: clamp(1.8rem, 2vw, 2.2rem); line-height: 1.5; }
    .content-banner-left p { margin-left: 0; }
    .content-banner a.content-banner-button { display: inline-block; margin-top: 28px; padding: 12px 24px; border-radius: 4px; color: #fff; background: var(--ghost-accent-color); font-size: 1.6rem; font-weight: 700; text-decoration: none; }
    .content-banner-button:hover { filter: brightness(1.2); }
</style>
