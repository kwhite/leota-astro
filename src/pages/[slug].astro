---
// Top-level URLs built from content: every post, plus every standalone page that sets a
// `template` in its frontmatter (pages without one have their own file in src/pages/).
// A hand-written file in src/pages/ with the same name takes priority over this route.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import CampaignNav from '../components/CampaignNav.astro';
import ScoundrelGallery from '../components/ScoundrelGallery.astro';
import CrewGallery from '../components/CrewGallery.astro';

type Props = { post: CollectionEntry<'posts'>; page?: never } | { page: CollectionEntry<'pages'>; post?: never };

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const pages = await getCollection('pages', ({ data }) => !!data.template);
  // A post and a templated page with the same file name would want the same URL: fail the build.
  const postIds = new Set(posts.map(post => post.id));
  const clash = pages.find(page => postIds.has(page.id));
  if (clash) throw new Error(`URL /${clash.id}/ is claimed by both a post and a page; rename one of them.`);
  return [
    ...posts.map(post => ({ params: { slug: post.id }, props: { post } })),
    ...pages.map(page => ({ params: { slug: page.id }, props: { page } })),
  ];
}

const { post, page } = Astro.props;
const { Content } = await render(post ?? page);

// Crew pages: the campaign's visible characters, plus its Scoundrels page so friends and rivals can link to their dossiers.
let crew: { characters: CollectionEntry<'characters'>[]; scoundrelsPage: CollectionEntry<'pages'> | undefined } | undefined;
if (page?.data.template === 'crew') {
  const campaign = page.data.campaign;
  crew = {
    characters: await getCollection('characters', ({ data }) => !data.hidden && data.campaigns.includes(campaign)),
    scoundrelsPage: (await getCollection('pages', ({ data }) => data.template === 'scoundrels' && data.campaign === campaign))[0],
  };
}
---

{post && (
  <PostLayout post={post}>
    <Content />
  </PostLayout>
)}
{page && (
  <PageLayout title={page.data.title} cover={page.data.cover} image={page.data.image} description={page.data.description} campaign={page.data.campaign} subclass="campaign-page">
    {page.data.campaignSection && <CampaignNav current={page.data.campaignSection} campaign={page.data.campaign} />}
    <Content />
    {page.data.template === 'scoundrels' && <ScoundrelGallery entries={page.data.scoundrels} />}
    {crew && <CrewGallery characters={crew.characters.map(c => c.data)} sheet={page.data.crew} scoundrels={crew.scoundrelsPage} />}
  </PageLayout>
)}
