---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import CampaignNav from '../components/CampaignNav.astro';
const page = await getEntry('pages', 'com-system-modifications');
if (!page) throw new Error('Missing page content: com-system-modifications');
const frontmatter = page.data;
const { Content } = await render(page);
---
<PageLayout title={frontmatter.title} cover={frontmatter.cover} description={frontmatter.description} subclass="campaign-page">
    {frontmatter.campaignSection && <CampaignNav current={frontmatter.campaignSection} />}
    <Content />
</PageLayout>
