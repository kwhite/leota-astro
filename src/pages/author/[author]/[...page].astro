---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import PostCard from '../../../components/PostCard.astro';
import ArchiveHeader from '../../../components/ArchiveHeader.astro';
import Pagination from '../../../components/Pagination.astro';
import { SITE_CONFIG, getAssetUrl } from '../../../config';

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection('posts');
  const allAuthors = await getCollection('authors');
  const paths: any[] = [];
  
  for (const authorEntry of allAuthors) {
    const author = authorEntry.id;
    const filteredPosts = allPosts.filter(post => post.data.author && post.data.author.id === author);
    filteredPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
    
    const pages = paginate(filteredPosts, { 
      pageSize: SITE_CONFIG.pageSize,
      params: { author }
    });
    
    pages.forEach((p: any) => {
      paths.push({
        params: { 
          author, 
          page: p.params.page === 1 || p.params.page === '1' || !p.params.page ? undefined : `page${p.params.page}`
        },
        props: {
          pageProps: p.props,
          maxPages: pages.length
        }
      });
    });
  }
  
  return paths;
}

const { author } = Astro.params;
const { pageProps, maxPages } = Astro.props;
const { page } = pageProps;

// Resolve author from data collections
const authorEntry = author ? await getEntry('authors', author) : null;
const authorData = authorEntry ? authorEntry.data : null;

if (!authorData) {
  return Astro.redirect('/404.html');
}

const totalPosts = page.total;
const statsText = totalPosts === 0 ? 'No posts' : totalPosts === 1 ? '1 post' : `${totalPosts} posts`;

// Header backgrounds
const coverImage = authorData.cover ? getAssetUrl(authorData.cover) : null;
const authorProfileImg = authorData.picture ? getAssetUrl(authorData.picture) : null;
---

<Layout title={authorData.name} description={authorData.bio} image={coverImage} current="author">
    <header class="site-header outer"><div class="inner"><SiteNav current="author" /></div></header>

    <!-- Main Content Area -->
    <main id="site-main" class="site-main outer" role="main">
        <div class="inner">
            <ArchiveHeader title={authorData.name} description={authorData.bio} cover={coverImage} portrait={authorProfileImg}>
                <div class="archive-meta">
                    {authorData.location && <div>{authorData.location}</div>}
                    <div>{statsText}</div>
                    <div class="archive-meta-links">
                        {typeof authorData.url_full === 'string' && authorData.url_full && <a href={authorData.url_full} rel="noopener">Website</a>}
                        {authorData.twitter && <a href={`https://twitter.com/${authorData.twitter}`} rel="noopener">Twitter</a>}
                        {authorData.facebook && <a href={`https://facebook.com/${authorData.facebook}`} rel="noopener">Facebook</a>}
                        <a href={getAssetUrl(`/author/${author}/feed.xml`)}>RSS feed</a>
                    </div>
                </div>
            </ArchiveHeader>
            <div class="post-feed" data-current-page={page.currentPage} data-max-pages={maxPages} data-base-url={getAssetUrl(`/author/${author}/`)}>
                {page.data.map((post: any) => (
                    <PostCard post={post} />
                ))}
            </div>
            <Pagination currentPage={page.currentPage} totalPages={maxPages} baseUrl={getAssetUrl(`/author/${author}/`)} />
        </div>
    </main>
</Layout>

<script>
  import { initInfiniteScroll } from '../../../utils/infinite-scroll';
  document.addEventListener('astro:page-load', () => {
    initInfiniteScroll('.post-feed');
  });
</script>

