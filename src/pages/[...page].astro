---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import AlgoliaSearch from '../components/AlgoliaSearch.astro';
import { SITE_CONFIG, getAssetUrl } from '../config';

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection('posts', ({ data }) => data.tags.includes(SITE_CONFIG.homepageTag));
  allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  
  const pages = paginate(allPosts, { pageSize: SITE_CONFIG.pageSize });
  
  return pages.map((p: any) => ({
    params: { 
      page: p.params.page === 1 || p.params.page === '1' || !p.params.page ? undefined : `page${p.params.page}` 
    },
    props: { 
      pageProps: p.props,
      maxPages: pages.length
    }
  }));
}

const { pageProps, maxPages } = Astro.props;
const { page } = pageProps;

// Determine header image
const headerBg = SITE_CONFIG.cover ? getAssetUrl(SITE_CONFIG.cover) : null;
---

<Layout current="home">
    <header class="publication-header">
        <div class="publication-navigation outer"><div class="inner"><SiteNav current="home" /></div></div>
        {headerBg && <img class="publication-cover" src={headerBg} alt="" fetchpriority="high" />}
        <div class="publication-intro inner">
            <h1 class="publication-title"><img src={getAssetUrl(SITE_CONFIG.logo)} alt={SITE_CONFIG.title} /></h1>
            <p class="publication-description">{SITE_CONFIG.description}</p>
        </div>
    </header>

    <!-- Main Content Feed -->
    <main id="site-main" class="site-main outer" role="main">
        <div class="inner">
            {SITE_CONFIG.algolia && (
                <div id="search-hits" class="post-feed" style="display: none;"></div>
            )}
            
            <div id="posts" class="post-feed" data-current-page={page.currentPage} data-max-pages={maxPages} data-base-url={getAssetUrl('/')}>
                {page.data.map((post: any, index: number) => (
                    <PostCard post={post} indexClass={index === 0 ? 'post-card-large' : index < 3 ? 'dynamic' : ''} />
                ))}
            </div>

            <Pagination currentPage={page.currentPage} totalPages={maxPages} baseUrl={getAssetUrl('/')} />
            {SITE_CONFIG.algolia && <AlgoliaSearch />}
        </div>
    </main>
</Layout>

<script>
  import { initInfiniteScroll } from '../utils/infinite-scroll';
  document.addEventListener('astro:page-load', () => {
    initInfiniteScroll('#posts');
  });
</script>


