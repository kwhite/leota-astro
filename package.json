{
  "name": "casper-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "email:preview": "node scripts/email.mjs preview",
    "email:test": "node --env-file-if-exists=.email/credentials.env scripts/email.mjs test",
    "email:send": "node --env-file-if-exists=.email/credentials.env scripts/email.mjs send",
    "email:check": "node --test scripts/tests/email.mjs",
    "media:prepare": "$(command -v /opt/homebrew/bin/python3 || command -v python3) scripts/prepare-media.py",
    "media:upload": "node scripts/upload-media.mjs --changed-since-git"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "^4.0.19",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "js-yaml": "^5.5.0",
    "typescript": "^7.0.2",
    "ultrahtml": "1.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
